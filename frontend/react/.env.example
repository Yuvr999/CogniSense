# CogniSense Map Configuration
# Default (Free, Open-Source, No API Key Required):
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional Alternative High-Detail Tile Providers:
# 1. Humanitarian OpenStreetMap:
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
#
# 2. ESRI World Street / Light Gray Canvas:
# VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
#
# 3. Stadia Maps (Requires free Stadia API key):
# VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=YOUR_STADIA_API_KEY
#
# 4. Mapbox (Requires Mapbox token):
# VITE_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/light-v11/tiles/{z}/{x}/{y}?access_token=YOUR_MAPBOX_TOKEN
